{
  "name": "chitrayaan",
  "version": "0.1.0",
  "private": true,
  "description": "Video ingestion, transcoding, and adaptive-bitrate streaming backend (VOD + reduced-scope live RTMP ingest).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "license": "MIT",
  "dependencies": {
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "@tus/utils": "^0.7.1",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "tus-js-client": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
