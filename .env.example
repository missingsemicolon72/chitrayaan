# Copy to .env and adjust. Values here are for local development.
# Every variable is validated at startup (src/config/env.ts); the process refuses to boot on bad config.

NODE_ENV=development
LOG_LEVEL=info

# API server
PORT=3000
HOST=127.0.0.1
# Shared secret sent as the X-API-Key header on every non-/healthz request. Min 16 chars.
API_KEY=change-me-to-a-long-random-string

# Storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
# Required only when STORAGE_BACKEND=s3 (MinIO locally)
#S3_ENDPOINT=http://127.0.0.1:9000
#S3_BUCKET=chitrayaan
#S3_ACCESS_KEY=minioadmin
#S3_SECRET_KEY=minioadmin
#S3_REGION=us-east-1

# Metadata DB: sqlite | postgres
DB_BACKEND=sqlite
SQLITE_PATH=./data/chitrayaan.sqlite
# Required only when DB_BACKEND=postgres
#DATABASE_URL=postgres://chitrayaan:chitrayaan@127.0.0.1:5432/chitrayaan

# Job queue (BullMQ)
REDIS_URL=redis://127.0.0.1:6379
# Transcode jobs a single worker process runs concurrently (FFmpeg is CPU-bound; 1-2 is typical)
WORKER_CONCURRENCY=1

# Transcoding
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# libx264 preset (ultrafast ... veryslow). medium = x264 default; veryfast is a good dev setting.
FFMPEG_PRESET=medium
# Per-job scratch directory (defaults to the OS temp dir). Needs room for one source + its outputs.
#WORK_DIR=./data/work

# Packaging + codecs
PACKAGE_FORMATS=hls,dash
# h264 is always on. Add ",av1" to also encode the ladder as AV1 (SVT-AV1; slower to encode,
# ~35% fewer bits at the same quality; plays in Chrome/Firefox/Edge, not older Safari).
CODEC_LADDER=h264
# SVT-AV1 preset 0-13 (higher = faster, lower quality per bit). 8 is a balanced default.
AV1_PRESET=8

# Optional features - all off by default
FEATURE_THUMBNAILS=false
FEATURE_SUBTITLES=false
FEATURE_WATERMARK=false
# Used only when FEATURE_WATERMARK=true
#WATERMARK_IMAGE_PATH=./assets/watermark.png
#WATERMARK_POSITION=bottom-right
#WATERMARK_OPACITY=0.6

# Upload (tus)
TUS_UPLOAD_MAX_SIZE_MB=4096

# Live ingest (phase 2)
RTMP_LISTEN_PORT=1935
#RTMP_STREAM_KEY=change-me

# Testing
TEST_SAMPLES_DIR=./test/samples
